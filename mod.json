{
  "geode": "5.0.0-beta.3",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "polik.chaos-mod",
  "name": "Chaos Mod",
  "version": "v1.0.0",
  "developer": "Polik",
  "description": "",
  "resources": {
    "files": [
      "resources/Soggy.jpg"
    ]
  },
  "settings": {
    "debug-title": {
      "type": "title",
      "name": "Debug"
    },
    "force-event": {
      "type": "bool",
      "name": "Force event",
      "description": "If enabled, Chaos Mod will always run the selected event instead of random.",
      "default": false
    },
    "forced-event-id": {
      "type": "string",
      "name": "Forced event",
      "description": "Which event to run when Force event is enabled.",
      "default": "random",
      "one-of": [
        "random",
        "speed-x0-5",
        "speed-x1-5",
        "speed-x2",
        "gravity-low",
        "gravity-high",
        "reverse-controls",
        "size-mini",
        "jump-delay",
        "soggy-jumpscare",
        "invert-colors",
        "shake-screen",
        "drunk-mode",
        "snow-screen"
      ],
      "enable-if": "force-event"
    }
  }
}
