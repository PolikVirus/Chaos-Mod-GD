{
  "geode": "5.4.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "polik.chaos-mod",
  "name": "Chaos Mod",
  "version": "v1.0.3",
  "developer": "Polik",
  "links": {
    "source": "https://github.com/PolikVirus/Chaos-Mod-GD"
  },
  "tags": [
    "gameplay",
    "offline",
    "joke"
  ],
  "description": "Random stuff happens every so often",
  "resources": {
    "files": [
      "resources/Soggy.jpg",
      "resources/doggie.png"
    ]
  },
  "settings": {
    "mod-enabled": {
      "type": "bool",
      "name": "Enable Mod",
      "description": "Turns the mod on or off.",
      "default": true
    },
    "timer-length": {
      "type": "int",
      "name": "Timer Length",
      "description": "Seconds between events.",
      "default": 30,
      "min": 5,
      "max": 60
    },
    "debug-title": {
      "type": "title",
      "name": "Debug"
    },
    "force-event": {
      "type": "bool",
      "name": "Force event",
      "description": "Always run the event you picked instead of rolling one.",
      "default": false
    },
    "forced-event-id": {
      "type": "string",
      "name": "Forced event",
      "description": "Which event to use when Force event is on.",
      "default": "random",
      "one-of": [
        "random",
        "speed-x0-5",
        "speed-x1-5",
        "speed-x2",
        "gravity-low",
        "gravity-high",
        "reverse-controls",
        "size-mini",
        "jump-delay",
        "pause-game",
        "soggy-jumpscare",
        "doggie-jumpscare",
        "invert-colors",
        "high-pitch",
        "low-pitch",
        "snow-screen",
        "fps-20"
      ],
      "enable-if": "force-event"
    }
  }
}