{
  "geode": "5.4.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "polik.chaos-mod",
  "name": "Chaos Mod",
  "version": "v1.0.0-beta.2",
  "developer": "Polik",
  "links": {
    "source": "https://github.com/PolikVirus/Chaos-Mod-GD"
  },
  "tags": ["gameplay", "offline", "joke"],
  "description": "Random events happen every 30 seconds. Chaos!",
  "resources": {
    "files": [
      "resources/Soggy.jpg"
    ]
  },
  "settings": {
    "mod-enabled": {
      "type": "bool",
      "name": "Enable Mod",
      "description": "Enable or disable the Chaos Mod",
      "default": true
    },
    "debug-title": {
      "type": "title",
      "name": "Debug"
    },
    "force-event": {
      "type": "bool",
      "name": "Force event",
      "description": "If enabled, Chaos Mod will always run the selected event instead of random.",
      "default": false
    },
    "forced-event-id": {
      "type": "string",
      "name": "Forced event",
      "description": "Which event to run when Force event is enabled.",
      "default": "random",
      "one-of": [
        "random",
        "speed-x0-5",
        "speed-x1-5",
        "speed-x2",
        "gravity-low",
        "gravity-high",
        "reverse-controls",
        "size-mini",
        "jump-delay",
        "soggy-jumpscare",
        "invert-colors",
        "shake-screen",
        "high-pitch",
        "low-pitch",
        "drunk-mode",
        "snow-screen",
        "flip-vertical",
        "flip-horizontal",
        "fps-20"
      ],
      "enable-if": "force-event"
    },
    "timer-length": {
      "type": "int",
      "name": "Timer Length",
      "description": "How long between events (in seconds)",
      "default": 30,
      "min": 5,
      "max": 60
    }
  }
}